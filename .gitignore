# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# User data, databases, and logs
data/
instance/
*.db
*.sqlite
*.sqlite3
*.log

# W7: the published methodology corpus under docs/methodology/data/ is tracked
# research input (recall-certificate provenance + SYNERGY slice), not user data.
# Without this negation `data/` would drop it, and a clean checkout would fail
# build/tests/test_w7_recall_certificate_docs.py.
!docs/methodology/data/

# Python and editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.idea/
.vscode/

# Generated Windows build output
build/Output/
build/.venv/
build/runtime/
build/wheelhouse/
build/*.exe
build/*.msi

# MM9-12: release-payload verifier output (build-manifest-*.json lands in the
# repo root on every local run) and the Windows validators' transient httpx
# dependency cache (MM9-08: build_windows.bat leaves build/validator_deps/
# behind when it fails between install and cleanup)
release-assets/
build/validator_deps/

# FL8/F1-3: local packaging work dirs, download cache, staging and the
# per-script mutex lock folders (stale locks are reclaimed automatically)
build/work-linux/
build/work-macos/
build/dist/
build/staging/
build/downloads/
build/.build-*.lock/
