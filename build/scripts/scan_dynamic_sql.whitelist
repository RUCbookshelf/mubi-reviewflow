# 动态 SQL 检查器白名单（文件:行号#理由）
#
# 仅登记 SQLite 语法确实无法参数绑定的位置：标识符（表名/别名）与 IN (...) 的
# 占位符列表。这些位置拼入的内容不是外部输入，具体数据值仍全部通过参数绑定。
# 每条对应源码处均已有注释说明。
custom_backend/import_review_actions.py:163#IN(?) 占位符个数由 record_ids 数量决定，SQLite 不支持绑定占位符列表；拼入内容仅为 '?'，id 值经参数绑定
custom_backend/research_trace_api.py:324#IN(?) 占位符个数由 subject_ids 数量决定，SQLite 不支持绑定占位符列表；拼入内容仅为 '?'，id 值经参数绑定
custom_backend/research_trace_api.py:360#ATTACH 的 schema 别名是 SQLite 标识符无法绑定；值由内部整数序号生成 trace_store_<index>
custom_backend/research_trace_api.py:382#跨库 UNION ALL 分支数随 store 数变化且分支内 schema 为 ATTACH 标识符；数据过滤值全部为 ? 参数
# ---- 2.1.5 waveA 泳道 S1（coscreen）：仅 SQLite 语法无法绑定、且值来自内部
# 元数据/固定常量的 3 处；每条对应源码处均已有注释说明。----
coscreen/db.py:749#PRAGMA 表名是 SQLite 标识符不能参数绑定；值取自本库 sqlite_master（内部元数据，非外部输入）
coscreen/db.py:1344#迁移目标表/列名取自 sqlite_master 发现的实际库结构（内部元数据，非外部输入），标识符不能参数绑定；数据值全部 ? 绑定
coscreen/review_workflow.py:158#executescript 不支持参数绑定；脚本由模块内固定 _SCHEMA 常量与会话前缀 BEGIN IMMEDIATE 拼接，无外部输入
